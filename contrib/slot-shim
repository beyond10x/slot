#!/bin/sh
# PATH shim: installed as `cargo`, `go`, `ignite` and `make` in a directory placed first on PATH,
# it sends build commands through slot and runs everything else directly.
#
# Through slot: every cargo subcommand (run, aliases such as xtask, external subcommands)
#               except the ones below that compile nothing
#               go build|test|vet|install
#               ignite build|test|conformance
#               make, every target
# Directly:     cargo fmt, metadata, tree, update, fetch, clean, add, … and cargo mutants (its
#               own builds start cargo by path), any other go or ignite subcommand, any command
#               inside a slot job (SLOT_JOB set), SLOT_SHIM_OFF=1, or when `slot` is not on PATH.
#               contrib/slot-shim.test.sh checks the routing.

name=${0##*/}
dir=${0%/*}
case $dir in /*) ;; *) dir=$(pwd)/$dir ;; esac

strip_path() {
  out=
  old_ifs=$IFS
  IFS=:
  for p in $PATH; do
    case $p in "$dir" | "$dir/") continue ;; esac
    if [ -n "$1" ] && [ "$p" -ef "$dir" ] 2>/dev/null; then continue; fi
    out=${out:+$out:}$p
  done
  IFS=$old_ifs
  PATH=$out
  export PATH
}
strip_path check

real=$(command -v -- "$name") || {
  echo "slot-shim: $name: not found on PATH" >&2
  exit 127
}

if [ -n "${SLOT_JOB:-}" ] || [ -n "${SLOT_SHIM_OFF:-}" ] || ! command -v slot >/dev/null 2>&1; then
  exec "$real" "$@"
fi

sub=
skip=
for a in "$@"; do
  if [ -n "$skip" ]; then skip=; continue; fi
  case $a in
    --color | --config | -Z | -C | --manifest-path) skip=1 ;;
    +* | -*) ;;
    *) sub=$a; break ;;
  esac
done

case $name:$sub in
  cargo: | cargo:fmt | cargo:metadata | cargo:locate-project | cargo:pkgid | cargo:search | \
  cargo:login | cargo:logout | cargo:owner | cargo:yank | cargo:version | cargo:help | \
  cargo:tree | cargo:update | cargo:generate-lockfile | cargo:fetch | cargo:vendor | cargo:new | \
  cargo:init | cargo:add | cargo:remove | cargo:clean | cargo:config | cargo:read-manifest | \
  cargo:verify-project | cargo:report | cargo:info | cargo:mutants)
    exec "$real" "$@"
    ;;
  cargo:* | \
  go:build | go:test | go:vet | go:install | \
  ignite:build | ignite:test | ignite:conformance | make:*)
    exec slot run -- "$real" "$@"
    ;;
esac
exec "$real" "$@"
