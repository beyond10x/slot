NODE_NAME=node-1
BUILD_USER=builder
BUILD_UID=1001
BUILD_HOME=/var/lib/builder
BUILD_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceWithTheBuildPublicKey build
SETUP_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceWithTheSetupPublicKey setup
SLOT_VERSION=0.36.0
MIRROR_DIRS=.local/state/worktree .cache src
GO_PRIVATE=git.example.org
MIN_FREE_DISK=50
SCCACHE_GB=200
TMP_GB=400
DOCKER_GB=10
CPU_PRESSURE=40
NODE_SSH=ssh -F /var/lib/builder/.config/slot/node/ssh_config
PUSH_HOST=node-1-setup
NODE_HOST=node-1
NODE_RUN_DIR=/var/lib/builder/src/slot
RUST_TOOLCHAINS=1.85.0 1.91.0 1.91.1 1.97 1.98.0 1.98.1 1.99.0 1.99.1 1.100.0 stable
RUST_COMPONENTS=clippy rustfmt
RUST_TARGETS=1.97:x86_64-unknown-linux-musl 1.98.1:wasm32-unknown-unknown,x86_64-unknown-linux-musl 1.99.1:x86_64-unknown-linux-musl
EXTRA_PACKAGES=jq sqlite bzip2 unzip binutils rsync git gcc gcc-c++ make cmake clang clang-devel llvm20 llvm-devel alsa-lib-devel postgresql17 postgresql17-server java-21-amazon-corretto-devel java-17-amazon-corretto-devel java-11-amazon-corretto-devel java-1.8.0-amazon-corretto-devel maven xorg-x11-server-Xvfb gtk3 libnotify libXScrnSaver libXtst at-spi2-atk atk mesa-libgbm libxkbcommon nss
